# Copia este archivo como .env para desarrollo local.
# En el despliegue, configura estas variables en el panel del proveedor (por ejemplo, Vercel).

# URI de MongoDB local o Atlas. Sustituye las credenciales y el nombre de la base de datos.
# Si la contraseña contiene caracteres especiales, codifícala para URL.
DATABASE_URL=mongodb+srv://USUARIO:CONTRASENA_CODIFICADA@CLUSTER/artefacto_grafico_db?retryWrites=true&w=majority

# Secreto largo y aleatorio para firmar los JWT. Genera uno distinto para cada entorno.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRET

# Origen(es) permitidos por CORS. Se admiten varios separados por comas.
# En producción, usa el dominio público del frontend.
FRONTEND_URL=http://localhost:5173

# Puerto del servidor local; la plataforma puede asignar uno automáticamente.
PORT=3000

# development para local; production en el entorno de despliegue.
NODE_ENV=development

# false para MongoDB local standalone. En Atlas, normalmente usa true (replica set).
MONGO_TRANSACTIONS=false